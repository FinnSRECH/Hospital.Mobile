<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Hospital.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Inloggen">

	<ScrollView>

		<VerticalStackLayout
            Padding="28"
            Spacing="18"
            VerticalOptions="Center">

			<Border
                BackgroundColor="White"
                Stroke="{StaticResource Border}"
                StrokeShape="RoundRectangle 18"
                Padding="24">

				<VerticalStackLayout
                    Spacing="16">

					<!-- LOGO -->

					<Label
                        Text="H+"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold"
                        FontSize="34"
                        HorizontalOptions="Center" />

					<Label
                        Text="Hospital Mobile"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />

					<Label
                        Text="Medewerkersportaal voor artsen en chirurgen"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold"
                        FontSize="13"
                        HorizontalTextAlignment="Center" />

					<Label
                        Text="Log in om je persoonlijke planning en patiëntinformatie veilig te bekijken."
                        TextColor="{StaticResource TextMuted}"
                        HorizontalTextAlignment="Center" />

					<BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Border}"
                        Margin="0,4" />

					<!-- E-MAIL -->

					<Label
                        Text="E-mailadres"
                        FontAttributes="Bold" />

					<Entry
                        x:Name="EmailEntry"
                        Keyboard="Email"
                        Placeholder="naam@hospital.nl"
                        Text="emma.jansen@hospital.nl"
                        ReturnType="Next" />

					<!-- WACHTWOORD -->

					<Label
                        Text="Wachtwoord"
                        FontAttributes="Bold" />

					<Entry
                        x:Name="PasswordEntry"
                        IsPassword="True"
                        Placeholder="Voer je wachtwoord in"
                        Text="Welkom123!"
                        ReturnType="Go"
                        Completed="OnPasswordCompleted" />

					<!-- WACHTWOORD VERGETEN -->

					<Button
                        Text="Wachtwoord vergeten?"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        FontSize="13"
                        HorizontalOptions="Start"
                        Padding="0,2"
                        Clicked="OnForgotPasswordClicked" />

					<!-- FOUTMELDING -->

					<Border
                        x:Name="ErrorContainer"
                        IsVisible="False"
                        BackgroundColor="#FDECEC"
                        Stroke="#F5BCBC"
                        StrokeShape="RoundRectangle 10"
                        Padding="12">

						<Label
                            x:Name="ErrorLabel"
                            TextColor="#9B2C2C" />

					</Border>

					<!-- INLOGGEN -->

					<Button
                        Text="Inloggen"
                        Clicked="OnLoginClicked" />

					<BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Border}"
                        Margin="0,4" />

					<!-- PRIVACY -->

					<Label
                        Text="Toegang is uitsluitend bedoeld voor bevoegde medewerkers. Patiëntgegevens worden vertrouwelijk behandeld."
                        TextColor="{StaticResource TextMuted}"
                        FontSize="12"
                        HorizontalTextAlignment="Center" />

				</VerticalStackLayout>

			</Border>

		</VerticalStackLayout>

	</ScrollView>

</ContentPage>