<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Hospital.Mobile.Views.PlanningPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Hospital.Mobile.Models"
    Title="Planning">

	<Grid
        RowDefinitions="Auto,*"
        Padding="20"
        RowSpacing="18">

		<VerticalStackLayout
            Spacing="6">

			<Label
                Text="Mijn planning"
                FontSize="28"
                FontAttributes="Bold" />

			<Label
                Text="Bekijk je consultaties en operaties en open direct de patiëntinformatie."
                TextColor="{StaticResource TextMuted}" />

		</VerticalStackLayout>

		<CollectionView
            x:Name="PlanningList"
            Grid.Row="1"
            SelectionMode="None">

			<CollectionView.EmptyView>

				<Border
                    Padding="20"
                    BackgroundColor="White"
                    Stroke="{StaticResource Border}"
                    StrokeShape="RoundRectangle 14">

					<VerticalStackLayout
                        Spacing="6">

						<Label
                            Text="Geen afspraken"
                            FontSize="18"
                            FontAttributes="Bold" />

						<Label
                            Text="Er staan momenteel geen consultaties of operaties in je planning."
                            TextColor="{StaticResource TextMuted}" />

					</VerticalStackLayout>

				</Border>

			</CollectionView.EmptyView>

			<CollectionView.ItemTemplate>

				<DataTemplate
                    x:DataType="models:MobileAppointment">

					<Border
                        Margin="0,0,0,14"
                        Padding="18"
                        BackgroundColor="White"
                        Stroke="{StaticResource Border}"
                        StrokeShape="RoundRectangle 14">

						<Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="6">

							<!-- TYPE -->

							<Label
                                Text="{Binding Type}"
                                TextColor="{StaticResource Primary}"
                                FontAttributes="Bold"
                                FontSize="13" />

							<!-- TITEL -->

							<Label
                                Grid.Row="1"
                                Text="{Binding Title}"
                                FontSize="19"
                                FontAttributes="Bold" />

							<!-- PATIËNT -->

							<HorizontalStackLayout
                                Grid.Row="2"
                                Spacing="6">

								<Label
                                    Text="Patiënt:"
                                    FontAttributes="Bold"
                                    FontSize="13" />

								<Label
                                    Text="{Binding PatientName}"
                                    FontSize="13" />

							</HorizontalStackLayout>

							<!-- LOCATIE -->

							<HorizontalStackLayout
                                Grid.Row="3"
                                Spacing="6">

								<Label
                                    Text="Locatie:"
                                    FontAttributes="Bold"
                                    FontSize="13" />

								<Label
                                    Text="{Binding Location}"
                                    FontSize="13"
                                    TextColor="{StaticResource TextMuted}" />

							</HorizontalStackLayout>

							<!-- DATUM EN TIJD -->

							<HorizontalStackLayout
                                Grid.Row="4"
                                Spacing="6">

								<Label
                                    Text="Datum:"
                                    FontAttributes="Bold"
                                    FontSize="13" />

								<Label
                                    Text="{Binding StartTime, StringFormat='{0:dd-MM-yyyy HH:mm}'}"
                                    FontSize="13" />

							</HorizontalStackLayout>

							<!-- STATUS -->

							<Border
                                Grid.Row="5"
                                HorizontalOptions="Start"
                                Padding="10,4"
                                Margin="0,4,0,0"
                                BackgroundColor="#E8F3F5"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">

								<Label
                                    Text="{Binding DisplayStatus}"
                                    TextColor="{StaticResource Primary}"
                                    FontAttributes="Bold"
                                    FontSize="12" />

							</Border>

							<!-- ACTIE -->

							<Button
                                Grid.Column="1"
                                Grid.RowSpan="6"
                                Text="Bekijken"
                                Clicked="OnViewClicked"
                                CommandParameter="{Binding Id}"
                                VerticalOptions="Center"
                                Margin="14,0,0,0" />

						</Grid>

					</Border>

				</DataTemplate>

			</CollectionView.ItemTemplate>

		</CollectionView>

	</Grid>

</ContentPage>