<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hospital.Mobile.Views.PlanningPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Hospital.Mobile.Models"
    Title="Planning">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="16">
        <VerticalStackLayout>
            <Label Text="Mijn planning" FontSize="28" FontAttributes="Bold" />
            <Label Text="Consultaties en operaties waarvoor je bent ingepland." TextColor="{StaticResource TextMuted}" />
        </VerticalStackLayout>

        <CollectionView x:Name="PlanningList" Grid.Row="1" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MobileAppointment">
                    <Border Margin="0,0,0,12" Padding="16" BackgroundColor="White" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 14">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <Label Text="{Binding Type}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                            <Label Grid.Row="2" Text="{Binding PatientName}" />
                            <Label Grid.Row="3" Text="{Binding Location}" TextColor="{StaticResource TextMuted}" />

                            <VerticalStackLayout Grid.Column="1" Grid.RowSpan="4" HorizontalOptions="End" Spacing="8">
                                <Label Text="{Binding StartTime, StringFormat='{0:dd-MM HH:mm}'}" FontAttributes="Bold" />
                                <Button Text="Bekijken" Clicked="OnViewClicked" CommandParameter="{Binding Id}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
