<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hospital.Mobile.Views.AppointmentDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Afspraak">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label x:Name="TypeLabel" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
            <Label x:Name="TitleLabel" FontSize="28" FontAttributes="Bold" />

            <Border BackgroundColor="White" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 14" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Patiënt" FontAttributes="Bold" />
                    <Label x:Name="PatientLabel" />
                    <Label Text="Datum en tijd" FontAttributes="Bold" />
                    <Label x:Name="DateLabel" />
                    <Label Text="Locatie" FontAttributes="Bold" />
                    <Label x:Name="LocationLabel" />
                    <Label Text="Behandelingsverslag" FontAttributes="Bold" />
                    <Label x:Name="ReportLabel" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Notitie" FontAttributes="Bold" />
            <Editor x:Name="NoteEditor" Placeholder="Voeg een korte notitie toe..." AutoSize="TextChanges" MinimumHeightRequest="100" />

            <Button Text="Afspraak afronden" Clicked="OnCompleteClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
